# Only real environment variables are read; this file documents them and is not loaded automatically.
# Model provider used by the agent. Default: mock (offline, deterministic). No other provider is implemented.
MODEL_PROVIDER=mock
# Not used by the mock provider. Real keys come only from the environment, never from committed files.
# ANTHROPIC_API_KEY is reserved for a future real provider and is not read today.
ANTHROPIC_API_KEY=
